/* Speaker layout and Radiant observations (build 98) */
"%@ copy" = "%@ 副本";
"%@ is listed twice." = "%@ 出现了两次。";
"%@ is not a speaker role." = "%@ 不是扬声器角色。";
"%@ m, distribution" = "%@ m（分布）";
