"Replace" = "Reemplazar";
"The CSV file could not be saved." = "No se pudo guardar el archivo CSV.";
"The PDF report could not be saved." = "No se pudo guardar el informe PDF.";
"Analysis failed" = "El análisis falló";
"Check that the file plays in another app, or choose another file." = "Comprueba que el archivo se reproduce en otra app o elige otro archivo.";
"Analysis cancelled" = "Análisis cancelado";
